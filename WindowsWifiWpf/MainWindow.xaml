<Window
    x:Class="WindowsWifiWpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Windows Wi-Fi P2P - Glory San"
    xmlns:local="clr-namespace:WindowsWifiWpf"
    Width="900"
    
    Height="650"
    AllowDrop="True"
    Background="#0F172A"
    Foreground="#F8FAFC"
    WindowStartupLocation="CenterScreen" >

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid Margin="20" x:Name="WindNormal" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="10"
                Background="#1E293B"
                BorderBrush="#3B82F6"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Vertical">
                        <Button x:Name="BtBrwonser"
                            Background="transparent"
                            Cursor = "Hand"
                            Visibility="{Binding NoPendingFiles, Converter={StaticResource BoolToVis}}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="#FF1062D6"
                            HorizontalAlignment="center"
                            Content="Glissez Deposez ou cliquez ici..."
                            BorderBrush="#FF0B1431"
                            Command="{Binding BrowseCommand}"/>
                        <StackPanel Orientation="Vertical">
                            <!--Button x:Name="BtBrwonser"
                                Background="transparent"
                                Cursor = "Hand"
                                Visibility="Visible"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="#FF1062D6"
                                HorizontalAlignment="center"
                                Content="Glissez Deposez ou cliquez ici..."
                                BorderBrush="#FF0B1431"
                                Click="BrowseButton_Click"/-->
                            <TextBlock
                                x:Name="DropStatusText"
                                HorizontalAlignment="Center"
                                Foreground="#38BDF8"
                                FontWeight="SemiBold"
                                                            Text="{Binding DropStatusText}"/>
                            </StackPanel>
                        
                    </StackPanel>
                    <Border
                        x:Name="cleaner"
                        BorderThickness="0"
                        Visibility="{Binding HasPendingFiles, Converter={StaticResource BoolToVis}}"
                        Grid.Row="1">
                        <StackPanel>
                            <Button
                                Background="Transparent"
                                Command="{Binding DeleteAllCommand}"
                                Cursor = "Hand"
                                FontSize="20"
                                FontWeight="SemiBold"
                                HorizontalAlignment="center"
                                BorderBrush="#FF0B1431"
                                Content="Clean"
                                Foreground="#FFF70505">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius"
                                                Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Border 
                                Background="#FF131A25"
                                BorderBrush="#3B82F6"
                                BorderThickness="0"
                                CornerRadius="12">
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Hidden">
                                    <ItemsControl x:Name="FilesItemsControl" ItemsSource="{Binding PendingFiles}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                    <Border

                                                        BorderThickness="0.2"
                                                        BorderBrush="White"
                                                        Background="transparent"
                                                        CornerRadius="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <StackPanel
                                                                    Orientation = "Vertical">
                                                                <TextBlock
                                                                    FontSize="16"
                                                                    Margin = "15,0"
                                                                    FontWeight="Bold"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="White"
                                                                    Text="{Binding Name}"/>
                                                                <StackPanel 
                                                                
                                                                    Margin="15,0,0,0"
                                                                    Orientation = "Horizontal">
                                                                
                                                                    <TextBlock
                                                                        FontWeight="Bold"
                                                                        FontSize="12"
                                                                        Foreground="#38BDF8"
                                                                        Text="{Binding Type}"/>
                                                                    <TextBlock
                                                                        FontWeight="Bold"
                                                                        FontSize="12"
                                                                        Foreground="#38BDF8"
                                                                        Text="{Binding Sizee}"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <Button
                                                                Grid.Column="1"
                                                                Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                Content="X"
                                                                Padding="12,0"
                                                                FontWeight="Bold"
                                                                FontSize="16"
                                                                Background="transparent"
                                                                Cursor="Hand"
                                                                Foreground="White"
                                                                Tag="{Binding}">
                                                                <Button.Resources>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="CornerRadius"
                                                                                Value="8"/>
                                                                    </Style>
                                                                </Button.Resources>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border 
                BorderBrush="#3B82F6"
                BorderThickness="0.3"
                CornerRadius="12"
                Padding="10" 
                Grid.Row="1"
                Margin="0,12,0,12">
                <ScrollViewer 
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <Button
                            Command="{Binding ReloadCommand}"
                            Content="retry"
                            FontWeight="Bold"
                            FontSize="14"
                            Background="transparent"
                            Cursor="Hand"
                            Foreground="Green">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <ItemsControl x:Name="DevicesItemsControl" ItemsSource="{Binding DiscoveredDevices}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin = "0,2,0,2"
                                        VerticalAlignment="Center"
                                        Padding="8"
                                        Background="#1E293B"
                                        CornerRadius="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width = "*"/>
                                                <ColumnDefinition Width = "Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel
                                                    
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse 
                                                        Height="9" 
                                                        Width="9" 
                                                        Margin = "0,0,8,0" 
                                                        Fill = "#FF31D8EE"/>
                                                    <TextBlock
                                                        FontSize ="16"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        Text="{Binding Name}"/>
                                                </StackPanel>
                                                
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Foreground="#38BDF8"
                                                    Text="{Binding Id}"/>
                                            </StackPanel>
                                            <Button
                                                Grid.Column = "1"
                                                Padding="12,0"
                                                HorizontalAlignment="Right"
                                                Background="#FF5174AC"
                                                BorderThickness="0.2"
                                                Command="{Binding DataContext.ConnectAndSendCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                Content="Envoyer vers l'appareil"
                                                Cursor="Hand"
                                                Foreground="White"
                                                Tag="{Binding}">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius"
                                                                Value="12"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel> 
                </ScrollViewer>
            </Border>
            <Border
                Grid.Row="2"
                Padding="4"
                Background="#1E293B"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        x:Name="MessageText"
                        Margin="0,0,0,30"
                        Foreground="#CBD5E1"
                                            Text="{Binding MessageText}"/>
                    <TextBlock
                        x:Name="ProgressText"
                        Margin="0,0,0,2"
                        Foreground="#CBD5E1"
                        Text="{Binding ProgressText}"/>
                    <ProgressBar
                        x:Name="TransferProgressBar"
                        Height="8"
                        Background="#0F172A"
                        BorderThickness="0"
                        Foreground="#38BDF8"
                        Maximum="100"
                                            Minimum="0"
                                            Value="{Binding TransferProgress}"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="WindError" Background="transparent" Visibility = "Collapsed">
            <Border Background="Gray">
                <Button  Command="{Binding RetryCommand}" Background="transparent" Content="retry" FontSize="21" Foreground="Green"/>
                
            </Border>
        </Grid>
    </Grid>
</Window>
