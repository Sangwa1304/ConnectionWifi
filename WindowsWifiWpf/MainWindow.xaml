<Window
    x:Class="WindowsWifiWpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Windows Wi-Fi P2P - Glory San"
    xmlns:local="clr-namespace:WindowsWifiWpf"
    Width="900"
    Height="650"
    AllowDrop="True"
    Background="#0f85fa11"
    Foreground="#F8FAFC"
    WindowStartupLocation="CenterScreen"
    FocusManager.IsFocusScope="True"
    KeyboardNavigation.TabNavigation="Cycle"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid Margin="20" x:Name="WindNormal" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="10"
                Background="#d12ea5e1"
                BorderBrush="#3B82F6"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="Statut : " Foreground="#CBD5E1" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentStateDisplayText}" Foreground="#38BDF8" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button x:Name="BtBrwonser"
                            Background="transparent"
                            Cursor = "Hand"
                            Visibility="{Binding NoPendingFiles, Converter={StaticResource BoolToVis}}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="#FF1062D6"
                            HorizontalAlignment="center"
                            Content="Glissez Deposez ou cliquez ici..."
                            BorderBrush="#FF0B1431"
                            Command="{Binding BrowseCommand}"
                            AutomationProperties.Name="Ajouter des fichiers ou dossiers"
                            TabIndex="0"/>
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                x:Name="DropStatusText"
                                HorizontalAlignment="Center"
                                Foreground="#38BDF8"
                                FontWeight="SemiBold"
                                Text="{Binding DropStatusText}"/>
                            <!--Button
                                Margin="0,10,0,0"
                                Content="Scanner"
                                Command="{Binding ScanCommand}"
                                Foreground="White"
                                Background="#1D4ED8"
                                Padding="14,6"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="Scanner les appareils disponibles"
                                TabIndex="1"/-->
                        </StackPanel>
                    </StackPanel>
                    <Border
                        x:Name="cleaner"
                        BorderThickness="0"
                        Visibility="{Binding HasPendingFiles, Converter={StaticResource BoolToVis}}"
                        Grid.Row="1">
                        <StackPanel>
                            <Button
                                Background="Transparent"
                                Command="{Binding DeleteAllCommand}"
                                Cursor = "Hand"
                                FontSize="20"
                                FontWeight="SemiBold"
                                HorizontalAlignment="center"
                                Content="Clean"
                                Foreground="#f8101005">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius"
                                                Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Border 
                                Background="#FF131A25"
                                BorderBrush="#3B82F6"
                                BorderThickness="0"
                                CornerRadius="12">
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto"
                                    CanContentScroll="False"
                                    Focusable="False">
                                    <ItemsControl x:Name="FilesItemsControl" ItemsSource="{Binding PendingFiles}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                    <Border

                                                        BorderThickness="0.2"
                                                        BorderBrush="White"
                                                        Background="transparent"
                                                        CornerRadius="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <StackPanel
                                                                    Orientation = "Vertical">
                                                                <TextBlock
                                                                    FontSize="16"
                                                                    Margin = "15,0"
                                                                    FontWeight="Bold"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="White"
                                                                    Text="{Binding Name}"/>
                                                                <StackPanel 
                                                                
                                                                    Margin="15,0,0,0"
                                                                    Orientation = "Horizontal">
                                                                
                                                                    <TextBlock
                                                                        FontWeight="Bold"
                                                                        FontSize="12"
                                                                        Foreground="#38BDF8"
                                                                        Text="{Binding Type}"/>
                                                                    <TextBlock
                                                                        FontWeight="Bold"
                                                                        FontSize="12"
                                                                        Foreground="#38BDF8"
                                                                        Text="{Binding Sizee}"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <Button
                                                                Grid.Column="1"
                                                                Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                Content="X"
                                                                Padding="12,0"
                                                                FontWeight="Bold"
                                                                FontSize="16"
                                                                Background="transparent"
                                                                Cursor="Hand"
                                                                Foreground="White"
                                                                Tag="{Binding}">
                                                                <Button.Resources>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="CornerRadius"
                                                                                Value="8"/>
                                                                    </Style>
                                                                </Button.Resources>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border 
                BorderBrush="#3B82F6"
                BorderThickness="0.3"
                CornerRadius="12"
                Padding="10" 
                Grid.Row="1">
                <ScrollViewer 
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    CanContentScroll="False"
                    Focusable="False">
                    <StackPanel>
                        <Border Background="#111827" CornerRadius="10" Padding="10" Margin="0,0,0,10" Visibility="{Binding IsTransferRequestVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Demande de réception" Foreground="#F8FAFC" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding TransferRequestSummary}" Foreground="#93C5FD" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Accepter" Command="{Binding AcceptTransferCommand}" Background="#16A34A" Foreground="White" Padding="12,6" Margin="0,0,8,0" AutomationProperties.Name="Accepter la demande de réception" TabIndex="2"/>
                                    <Button Content="Refuser" Command="{Binding RejectTransferCommand}" Background="#DC2626" Foreground="White" Padding="12,6" AutomationProperties.Name="Refuser la demande de réception" TabIndex="3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#111827" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Dossier de réception :" Foreground="#E2E8F0" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding DownloadFolderDisplay}" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" Width="400"/>
                                </StackPanel>
                                <Button Content="Ouvrir le dossier" Command="{Binding OpenDownloadFolderCommand}" Background="#0EA5E9" Foreground="White" Padding="12,6" HorizontalAlignment="Left" AutomationProperties.Name="Ouvrir le dossier de réception" TabIndex="4"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button
                                Command="{Binding ReloadCommand}"
                                Content="lancer la recherche"
                                FontWeight="Bold"
                                FontSize="14"
                                Background="#0F766E"
                                Cursor="Hand"
                                Foreground="White"
                                Padding="12,6"
                                
                                AutomationProperties.Name="Relancer la recherche d'appareils"
                                TabIndex="5">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <TextBlock Text="{Binding SelectedPeerName}" Foreground="#E2E8F0" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                            <TextBlock Text="Historique" Foreground="#F8FAFC" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Content="Effacer" Command="{Binding ClearTransferHistoryCommand}" Visibility="{Binding HasRecentTransfers, Converter={StaticResource BoolToVis}}" Background="#374151" Foreground="White" Margin="12,0,0,0" Padding="10,4" AutomationProperties.Name="Effacer l'historique des transferts" TabIndex="6"/>
                        </StackPanel>
                        <ItemsControl x:Name="RecentTransfersItemsControl" ItemsSource="{Binding RecentTransfers}" Visibility="{Binding HasRecentTransfers, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2,0,2" Padding="8" Background="#0F172A" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Type}" Foreground="#93C5FD" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Status}" Foreground="#22C55E"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DisplaySize}" Foreground="#CBD5E1"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl x:Name="DevicesItemsControl" ItemsSource="{Binding DiscoveredDevices}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin = "0,2,0,2"
                                        VerticalAlignment="Center"
                                        Padding="8"
                                        Background="#1E293B"
                                        CornerRadius="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width = "*"/>
                                                <ColumnDefinition Width = "Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel
                                                    
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse 
                                                        Height="9" 
                                                        Width="9" 
                                                        Margin = "0,0,8,0" 
                                                        Fill = "#FF31D8EE"/>
                                                    <TextBlock
                                                        FontSize ="16"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        Text="{Binding Name}"/>
                                                </StackPanel>
                                                
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Foreground="#38BDF8"
                                                    Text="{Binding Id}"/>
                                            </StackPanel>
                                            <Button
                                                Grid.Column = "1"
                                                Padding="12,0"
                                                HorizontalAlignment="Right"
                                                Background="#FF5174AC"
                                                BorderThickness="0.2"
                                                Command="{Binding DataContext.ConnectAndSendCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                Content="Envoyer vers l'appareil"
                                                Cursor="Hand"
                                                Foreground="White"
                                                Tag="{Binding}"
                                                AutomationProperties.Name="Envoyer des fichiers à l'appareil sélectionné"
                                                TabIndex="7">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius"
                                                                Value="12"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel> 
                </ScrollViewer>
            </Border>
            <Border
                Grid.Row="2"
                Padding="4"
                Background="#1E293B"
                CornerRadius="8">
                <StackPanel>
                   <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                       <TextBlock Text="État : " Foreground="#CBD5E1" FontWeight="SemiBold"/>
                       <TextBlock Text="{Binding CurrentTransferStatusText}" Foreground="#38BDF8" FontWeight="SemiBold"/>
                   </StackPanel>
                   <TextBlock
                       x:Name="MessageText"
                       Margin="0,0,0,8"
                       Foreground="#CBD5E1"
                       Text="{Binding MessageText}"/>
                   <TextBlock
                       x:Name="ProgressText"
                       Margin="0,0,0,2"
                       Foreground="#CBD5E1"
                       Text="{Binding ProgressText}"/>
                   <ProgressBar
                       x:Name="TransferProgressBar"
                       Height="8"
                       Background="#0F172A"
                       BorderThickness="0"
                       Foreground="#38BDF8"
                       Maximum="100"
                       Minimum="0"
                       Value="{Binding TransferProgress}"/>
                   <Button
                       Margin="0,10,0,0"
                       Content="Annuler"
                       Command="{Binding CancelTransferCommand}"
                       Background="#DC2626"
                       Foreground="White"
                       HorizontalAlignment="Left"
                       Padding="12,6"
                       AutomationProperties.Name="Annuler le transfert actuel"
                       TabIndex="8"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="WindError" 
            Background="transparent" 
            Visibility = "Collapsed">
            <Border Background="Gray">
                <Button 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Command="{Binding RetryCommand}" 
                    Background="transparent" 
                    Content="retry" 
                    FontSize="21" 
                    Foreground="Green"/>
            </Border>
        </Grid>
    </Grid>
</Window>
