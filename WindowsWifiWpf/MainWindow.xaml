<Window x:Class="WindowsWifiWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowsWifiWpf"
        mc:Ignorable="d"
        Title="Partage Wi-Fi Direct" Height="560" Width="900" MinHeight="480" MinWidth="760">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Partage de fichiers" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="Non initialisé" VerticalAlignment="Center" />
        </DockPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,14">
            <Button Content="Initialiser" Click="InitializeButton_Click" Padding="14,7" Margin="0,0,8,0" />
            <Button Content="Publier" Click="PublishButton_Click" Padding="14,7" Margin="0,0,8,0" />
            <Button Content="Rechercher" Click="SubscribeButton_Click" Padding="14,7" Margin="0,0,8,0" />
            <Button Content="Arrêter" Click="StopButton_Click" Padding="14,7" />
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Appareils détectés" Grid.Column="0" Margin="0,0,12,0">
                <DockPanel Margin="10">
                    <Button DockPanel.Dock="Bottom" Content="Se connecter" Click="ConnectButton_Click" Padding="12,7" Margin="0,10,0,0" />
                    <ListBox x:Name="PeersList" DisplayMemberPath="Name" />
                </DockPanel>
            </GroupBox>

            <GroupBox Header="Transfert" Grid.Column="1">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Fichier à envoyer" Margin="0,0,0,5" />
                    <DockPanel Grid.Row="1">
                        <Button DockPanel.Dock="Right" Content="Parcourir" Click="BrowseButton_Click" Padding="10,5" Margin="8,0,0,0" />
                        <TextBox x:Name="FilePathTextBox" IsReadOnly="True" />
                    </DockPanel>
                    <TextBlock Grid.Row="2" Text="Dossier de réception" Margin="0,14,0,5" />
                    <TextBox Grid.Row="3" x:Name="StoragePathTextBox" Text="%USERPROFILE%\Downloads\ConnectionWifi" />
                    <StackPanel Grid.Row="4" Margin="0,18,0,0">
                        <Button Content="Envoyer le fichier" Click="SendButton_Click" Padding="12,7" HorizontalAlignment="Left" />
                        <ProgressBar x:Name="TransferProgressBar" Height="18" Margin="0,14,0,5" Minimum="0" Maximum="100" />
                        <TextBlock x:Name="TransferText" Text="Aucun transfert" />
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="MessageText" Margin="0,14,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
