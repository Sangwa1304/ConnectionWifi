<Window
    x:Class="WindowsWifiWpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Windows Wi-Fi P2P - Glory San"
    xmlns:local="clr-namespace:WindowsWifiWpf"
    Width="900"
    
    Height="650"
    AllowDrop="True"
    Background="#0F172A"
    DragEnter="Window_DragEnter"
    Drop="Window_Drop"
    Foreground="#F8FAFC"
    WindowStartupLocation="CenterScreen" >

    <Grid>
        <Grid Margin="20" x:Name="WindNormal" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="10"
                Background="#1E293B"
                BorderBrush="#3B82F6"
                BorderThickness="2"
                CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4*"/>
                            <RowDefinition Height="6*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Width="Auto" Grid.Row="0">
                            <TextBlock x:Name="glisser"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#94A3B8"
                            HorizontalAlignment="center"
                            Text="Glissez vos fichiers ou dossiers ici..."/>
                            <Button x:Name="BtBrwonser"
                                
                                Content="Clique ici..."
                                Background="transparent"
                                Cursor = "Hand"
                                Width="Auto"
                                Height = "Auto"
                                FontSize="18"
                                FontWeight="SemiBold"
                                BorderBrush="Transparent"
                                Margin = "0,-8,0,0"
                                Click="BrowseButton_Click"
                                Foreground="#FF5B97B1"/>
                        
                            <TextBlock
                                x:Name="DropStatusText"
                                Margin = "0,-8,0,0"
                                HorizontalAlignment="Center"
                                Foreground="#38BDF8"
                                    Text="Aucun élément sélectionné"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Hidden">
                            <StackPanel>
                                <Button x:Name="cleaner"
                                    Visibility = "Collapsed"
                                    Grid.Row="0"
                                    Background="Transparent"
                                    Click="Delette_Contents_Click"
                                    Content="Clean"
                                    Width="Auto"
                                    Height = "Auto"
                                    Cursor="Hand"
                                    Foreground="#FFF70505"
                                    Tag="{Binding}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius"
                                                    Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            
                                <ItemsControl x:Name="FilesItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Padding="16"
                                                Background="#1E293B"
                                                CornerRadius="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <StackPanel Grid.Column="0" 
                                                            VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="16"
                                                            FontWeight="Bold"
                                                            Foreground="White"
                                                            Text="{Binding Name}"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                        
                                                        <!--TextBlock
                                                            FontSize="13"
                                                            Foreground="#94A3B8"
                                                            Text="{Binding IpAddress}"/-->
                                                        
                                                        <TextBlock
                                                            Margin="4,0,4,0"
                                                            FontWeight="Bold"
                                                            FontSize="14"
                                                            Foreground="#38BDF8"
                                                            Text="{Binding Type}"/>
                                                        <TextBlock
                                                            Margin="4,0,4,0"
                                                            Grid.Column ="2"
                                                            FontWeight="Bold"
                                                            FontSize="14"
                                                            Foreground="#38BDF8"
                                                            Text="{Binding Sizee}"/>
                                                        <TextBlock
                                                            Margin="4,0,4,0"
                                                            Grid.Column ="1"
                                                            FontWeight="Bold"
                                                            FontSize="14"
                                                            Foreground="#38BDF8"
                                                            Text="  :  "/>
                                                        </Grid>
                                                    </StackPanel>

                                                    <Button
                                                        Grid.Column="1"
                                                        BorderThickness="0.1"
                                                        Click="Delette_Content_Click"
                                                        Content="X"
                                                        FontSize="14"
                                                        Width="Auto"
                                                        Height="Auto"
                                                        Cursor="Hand"
                                                        Foreground="#FFF70505"
                                                        Tag="{Binding}">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius"
                                                                        Value="8"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    
                        <!--Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                        
                            <Button 
                                Visibility = "Visible"
                                Grid.Row="0"
                                Background="Transparent"
                                Click="Delette_Contents_Click"
                                Content="Clean"
                                Width="Auto"
                                Cursor="Hand"
                                Foreground="#FFF70505"
                                Tag="{Binding}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius"
                                                Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Hidden">
                            <ItemsControl x:Name="FilesItemsControl"  Grid.Row="1">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Padding="16"
                                            Background="#1E293B"
                                            CornerRadius="10">
                                            <Grid >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock
                                                        Foreground="White"
                                                        Text="{Binding Name}"/>
                                                    <TextBlock
                                                        Foreground="#94A3B8"
                                                        Text="{Binding Sizee}"/>
                                                    <TextBlock
                                                        Foreground="#38BDF8"
                                                        Text="{Binding Type}"/>
                                                </StackPanel>

                                                <Button
                                                    Grid.Column="1"
                                                    Background="Transparent"
                                                    BorderThickness="0.1"
                                                    Click="Delette_Content_Click"
                                                    Content="X"
                                                    Width="Auto"
                                                    Cursor="Hand"
                                                    Foreground="#FFF70505"
                                                    Tag="{Binding}">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius"
                                                                    Value="8"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </Grid>
                                            
                                            
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid-->
            </Border>

            <Border 
                BorderBrush="#3B82F6"
                BorderThickness="0.3"
                CornerRadius="12"
                Padding="40" 
                Grid.Row="1"
                Margin="0,12,0,12">
                <ScrollViewer 
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="DevicesItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="16"
                                    Background="#1E293B"
                                    CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0"
                                                VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="{Binding Name}"/>
                                            <!--TextBlock
                                                FontSize="13"
                                                Foreground="#94A3B8"
                                                Text="{Binding IpAddress}"/-->
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                FontSize="10"
                                                Foreground="#38BDF8"
                                                Text="{Binding Id}"/>
                                        </StackPanel>

                                        <Button
                                            Grid.Column="1"
                                            Padding="16,10"
                                            Background="#3B82F6"
                                            BorderThickness="0"
                                            Click="BtnConnectAndSend_Click"
                                            Content="Envoyer vers l'appareil"
                                            Cursor="Hand"
                                            Foreground="White"
                                            Tag="{Binding}">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius"
                                                            Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <Border
                Grid.Row="2"
                Padding="15"
                Background="#1E293B"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        x:Name="MessageText"
                        Margin="0,0,0,8"
                        Background="Black"
                        
                        Foreground="#CBD5E1"
                        Text="En attente..."/>
                    <TextBlock
                        x:Name="ProgressText"
                        Margin="0,0,0,8"
                        Foreground="#CBD5E1"
                        Text="En attente..."/>
                    <ProgressBar
                        x:Name="TransferProgressBar"
                        Height="8"
                        Background="#0F172A"
                        BorderThickness="0"
                        Foreground="#38BDF8"
                        Maximum="100"
                        Minimum="0"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="WindError" Background="transparent" Visibility = "Collapsed">
            <Border Background="Gray">
                <Button  Click = "Retry_Button" Background="transparent" Content="retry" FontSize="21" Foreground="Green"/>
                
            </Border>
        </Grid>
    </Grid>
</Window>
