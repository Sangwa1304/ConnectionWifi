<Window
    x:Class="WindowsWifiWpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WindowsWifiWpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Windows Wi-Fi P2P - NextGen"
    Width="620"
    Height="720"
    MinWidth="500"
    MinHeight="600"
    MaxWidth="660"
    MaxHeight="760"
    AllowDrop="True"
    Background="#0B0F19"
    Foreground="#F8FAFC"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:StatusToColorConverter x:Key="StatusToColor" />

        <!-- Animation d'entrée fluide (Fade-In et Translation) pour la liste des fichiers et demandes -->
        <Storyboard x:Key="FluidEntranceAnimation">
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="0" To="1"
                Duration="0:0:0.45" />
            <DoubleAnimation
                Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.Y)"
                From="15" To="0"
                Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Style pour les Boutons Principaux avec États Visuels Réactifs -->
        <Style x:Key="CaptivatingButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Cyber-Réactif de la Zone Drag & Drop Piloté par le ViewModel -->
        <Style x:Key="DropZoneButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="dropContainer">
                            <Rectangle
                                x:Name="dropBorder"
                                Fill="{TemplateBinding Background}"
                                RadiusX="12"
                                RadiusY="12"
                                Stroke="#334155"
                                StrokeDashArray="4 4"
                                StrokeThickness="2" />
                            <Border Padding="30">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Survol effectif d'un fichier physique au-dessus de l'application -->
                            <DataTrigger Binding="{Binding IsFileOverDropZone}" Value="True">
                                <Setter TargetName="dropBorder" Property="Fill" Value="#0A1224" />
                                <Setter TargetName="dropBorder" Property="Stroke" Value="#38BDF8" />
                                <Setter TargetName="dropBorder" Property="StrokeThickness" Value="2.5" />
                            </DataTrigger>
                            <!-- Survol standard à la souris seule -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsFileOverDropZone}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="dropBorder" Property="Fill" Value="#1E293B" />
                                <Setter TargetName="dropBorder" Property="Stroke" Value="#475569" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- EN-TÊTE ULTRA-MODERNE : STATUT GLOBAL -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,15"
            Padding="15,10"
            Background="#111827"
            BorderBrush="#1E293B"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Ellipse
                        Width="10"
                        Height="10"
                        Margin="0,0,10,0"
                        Fill="#22C55E">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            AutoReverse="True"
                                            Storyboard.TargetProperty="Opacity"
                                            From="1.0"
                                            To="0.3"
                                            Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock
                        FontSize="11"
                        FontWeight="Black"
                        Foreground="#64748B"
                        Text="RÉSEAU P2P ACTIVÉ |" />
                    <TextBlock
                        Margin="10,0,0,0"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#38BDF8"
                        Text="{Binding CurrentStateDisplayText}" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#64748B"
                        Text="Dossier : " />
                    <TextBlock
                        Margin="5,0"
                        MaxWidth="150"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#E2E8F0"
                        Text="{Binding DownloadFolderDisplay}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding DownloadFolder}" />
                    <Button
                        Margin="10,0,0,0"
                        Padding="10,4"
                        Background="#1E293B"
                        Command="{Binding ChangeFolderCommand}"
                        Content="Changer"
                        Cursor="Hand"
                        FontSize="11"
                        Style="{StaticResource CaptivatingButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ZONE INTERACTIVE : GLISSER-DÉPOSER ET LISTE DES FICHIERS -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <!-- Zone d'invite par défaut (Si aucun fichier n'est en attente) -->
            <Button
                Command="{Binding BrowseCommand}"
                Style="{StaticResource DropZoneButtonStyle}"
                Visibility="{Binding NoPendingFiles, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        FontSize="36"
                        Text="⚡" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#F1F5F9"
                        Text="Glissez-déposez vos fichiers ici" />
                    <TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="#64748B"
                        Text="ou cliquez pour parcourir votre stockage local" />
                </StackPanel>
            </Button>

            <!-- Liste des fichiers avec animation fluide d'apparition lors du chargement -->
            <Border
                Padding="15"
                Background="#111827"
                BorderBrush="#1E293B"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="{Binding HasPendingFiles, Converter={StaticResource BoolToVis}}">
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource FluidEntranceAnimation}"/>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="#94A3B8"
                            Text="Fichiers prêts à l'envoi" />
                        <Button
                            Padding="12,5"
                            HorizontalAlignment="Right"
                            Background="#EF4444"
                            Command="{Binding DeleteAllCommand}"
                            Content="Tout vider"
                            Cursor="Hand"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="White" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PendingFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,4"
                                        Padding="12,10"
                                        Background="#1E293B"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="#F8FAFC"
                                                    Text="{Binding Name}" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="11"
                                                    Foreground="#64748B"
                                                    Text="{Binding Sizee}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="✕"
                                                Cursor="Hand"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="#94A3B8" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ZONE CENTRALE : APPAREILS DISPONIBLES ET DEMANDES -->
        <Grid Grid.Row="2" Margin="0,5,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5.5*" />
                <ColumnDefinition Width="4.5*" />
            </Grid.ColumnDefinitions>

            <!-- Liste des Appareils Cibles -->
            <Border
                Grid.Column="0"
                Margin="0,0,10,0"
                Padding="15"
                Background="#111827"
                BorderBrush="#1E293B"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                FontSize="16"
                                FontWeight="Black"
                                Foreground="White"
                                Text="Appareils à proximité" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="11"
                                Foreground="#64748B"
                                Text="Sélectionnez une cible pour l'envoi" />
                        </StackPanel>
                        <Button
                            Padding="16,8"
                            HorizontalAlignment="Right"
                            Command="{Binding ScanCommand}"
                            Content="Rechercher"
                            FontSize="12"
                            Style="{StaticResource CaptivatingButtonStyle}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DiscoveredDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,4"
                                        Padding="12,10"
                                        Background="#1E293B"
                                        BorderBrush="#2563EB"
                                        BorderThickness="0.5"
                                        CornerRadius="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="#F8FAFC"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="9"
                                                    Foreground="#64748B"
                                                    Text="{Binding Id}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Padding="10,6"
                                                Command="{Binding DataContext.ConnectAndSendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="Envoyer →"
                                                FontSize="11"
                                                Style="{StaticResource CaptivatingButtonStyle}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Volet de droite : Demande reçue animée & Historique -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <!-- Notification Flash de demande entrante (Animation Pulse intégrée) -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    Padding="15"
                    Background="#064E3B"
                    BorderBrush="#10B981"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding IsTransferRequestVisible, Converter={StaticResource BoolToVis}}">
                    <Border.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="Visibility" Value="Visible">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource FluidEntranceAnimation}"/>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock
                            FontSize="13"
                            FontWeight="Black"
                            Foreground="#10B981"
                            Text="📥 Demande reçue" />
                        <TextBlock
                            Margin="0,6"
                            FontSize="12"
                            Foreground="#E2E8F0"
                            Text="{Binding TransferRequestSummary}"
                            TextWrapping="Wrap" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Margin="0,0,5,0"
                                Padding="10,6"
                                Background="#10B981"
                                Command="{Binding AcceptTransferCommand}"
                                Content="Accepter"
                                Cursor="Hand"
                                FontWeight="Bold"
                                Foreground="White" />
                            <Button
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                Padding="10,6"
                                Background="#EF4444"
                                Command="{Binding RejectTransferCommand}"
                                Content="Refuser"
                                Cursor="Hand"
                                FontWeight="Bold"
                                Foreground="White" />
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Historique Complet des Transmissions -->
                <Border
                    Grid.Row="1"
                    Padding="15"
                    Background="#111827"
                    BorderBrush="#1E293B"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Foreground="#94A3B8"
                                Text="Flux récents" />
                            <Button
                                Padding="8,3"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding ClearTransferHistoryCommand}"
                                Content="Effacer"
                                Cursor="Hand"
                                FontSize="10"
                                Foreground="#64748B" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RecentTransfers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,3"
                                            Padding="10"
                                            Background="#0F172A"
                                            CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="White"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="11"
                                                        Foreground="#38BDF8"
                                                        Text="{Binding Type}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                                    Text="{Binding Status}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- COMPOSANT BAS DE PAGE : PROGRESSION CYBER-FLUIDE -->
        <Border
            Grid.Row="3"
            Padding="20,15"
            Background="#111827"
            BorderBrush="#1E293B"
            BorderThickness="1"
            CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#F8FAFC"
                        Text="{Binding MessageText}" />
                    <TextBlock
                        Margin="0,4,0,8"
                        FontSize="12"
                        Foreground="#64748B"
                        Text="{Binding ProgressText}" />
                    <Grid>
                        <ProgressBar
                            Height="8"
                            Background="#1E293B"
                            BorderThickness="0"
                            Foreground="#38BDF8"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding TransferProgress}">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid x:Name="TemplateRoot" SnapsToDevicePixels="true">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                                        <Border
                                            x:Name="PART_Indicator"
                                            HorizontalAlignment="Left"
                                            Background="{TemplateBinding Foreground}"
                                            CornerRadius="4" />
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                    </Grid>
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Margin="20,0,0,0"
                    Padding="15,10"
                    VerticalAlignment="Center"
                    Background="#DC2626"
                    Command="{Binding CancelTransferCommand}"
                    Content="Annuler"
                    Cursor="Hand"
                    FontWeight="Bold"
                    Foreground="White"
                    Style="{StaticResource CaptivatingButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>