<Window
    x:Class="WindowsWifiWpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WindowsWifiWpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Windows Wi-Fi P2P - NextGen"
    Width="620"
    Height="720"
    MinWidth="500"
    MinHeight="600"
    MaxWidth="660"
    MaxHeight="760"
    AllowDrop="True"
    Background="#0B0F19"
    Foreground="#F8FAFC"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  Style pour les Boutons Principaux avec Animation Fluide  -->
        <Style x:Key="CaptivatingButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation
                                            Storyboard.TargetName="border"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#1D4ED8"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation
                                            Storyboard.TargetName="border"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#2563EB"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Style pour la Zone de Drag & Drop Interactive Compatible Noesis  -->
        <Style x:Key="DropZoneButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="dropContainer">
                            <Rectangle
                                x:Name="dropBorder"
                                Fill="{TemplateBinding Background}"
                                RadiusX="12"
                                RadiusY="12"
                                Stroke="#334155"
                                StrokeDashArray="4 4"
                                StrokeThickness="2" />
                            <Border Padding="30">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation
                                            Storyboard.TargetName="dropBorder"
                                            Storyboard.TargetProperty="(Rectangle.Fill).(SolidColorBrush.Color)"
                                            To="#0F172A"
                                            Duration="0:0:0.2" />
                                        <ColorAnimation
                                            Storyboard.TargetName="dropBorder"
                                            Storyboard.TargetProperty="(Rectangle.Stroke).(SolidColorBrush.Color)"
                                            To="#38BDF8"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation
                                            Storyboard.TargetName="dropBorder"
                                            Storyboard.TargetProperty="(Rectangle.Fill).(SolidColorBrush.Color)"
                                            To="#1E293B"
                                            Duration="0:0:0.2" />
                                        <ColorAnimation
                                            Storyboard.TargetName="dropBorder"
                                            Storyboard.TargetProperty="(Rectangle.Stroke).(SolidColorBrush.Color)"
                                            To="#334155"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  EN-TÊTE ULTRA-MODERNE : STATUT GLOBAL  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,15"
            Padding="15,10"
            Background="#111827"
            BorderBrush="#1E293B"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Ellipse
                        Width="10"
                        Height="10"
                        Margin="0,0,10,0"
                        Fill="#22C55E">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            AutoReverse="True"
                                            Storyboard.TargetProperty="Opacity"
                                            From="1.0"
                                            To="0.3"
                                            Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock
                        FontSize="11"
                        FontWeight="Black"
                        Foreground="#64748B"
                        Text="RÉSEAU P2P ACTIVÉ  |" />
                    <TextBlock
                        Margin="10,0,0,0"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#38BDF8"
                        Text="{Binding CurrentStateDisplayText}" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#64748B"
                        Text="Dossier : " />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#E2E8F0"
                        Text="{Binding DownloadFolderDisplay}" />
                    <Button
                        Margin="10,0,0,0"
                        Padding="10,4"
                        Background="#1E293B"
                        Command="{Binding OpenDownloadFolderCommand}"
                        Content="Changer"
                        Cursor="Hand"
                        FontSize="11"
                        Foreground="#94A3B8" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ZONE INTERACTIVE : GLISSER-DÉPOSER ET LISTE  -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Button
                Command="{Binding BrowseCommand}"
                Style="{StaticResource DropZoneButtonStyle}"
                Visibility="{Binding NoPendingFiles, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        FontSize="36"
                        Text="⚡" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#F1F5F9"
                        Text="Glissez-déposez vos fichiers ici" />
                    <TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="#64748B"
                        Text="ou cliquez pour parcourir votre stockage local" />
                </StackPanel>
            </Button>

            <Border
                Padding="15"
                Background="#111827"
                BorderBrush="#1E293B"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="{Binding HasPendingFiles, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="#94A3B8"
                            Text="Fichiers prêts à l'envoi" />
                        <Button
                            Padding="12,5"
                            HorizontalAlignment="Right"
                            Background="#EF4444"
                            Command="{Binding DeleteAllCommand}"
                            Content="Tout vider"
                            Cursor="Hand"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="White" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PendingFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,4"
                                        Padding="12,10"
                                        Background="#1E293B"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="#F8FAFC"
                                                    Text="{Binding Name}" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="11"
                                                    Foreground="#64748B"
                                                    Text="{Binding Sizee}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="✕"
                                                Cursor="Hand"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="#94A3B8" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!--  ZONE CENTRALE : APPAREILS DISPONIBLES ET DEMANDES  -->
        <Grid Grid.Row="2" Margin="0,5,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="0,0,10,0"
                Padding="15"
                Background="#111827"
                BorderBrush="#1E293B"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                FontSize="16"
                                FontWeight="Black"
                                Foreground="White"
                                Text="Appareils à proximité" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="11"
                                Foreground="#64748B"
                                Text="Sélectionnez une cible pour démarrer l'envoi direct" />
                        </StackPanel>
                        <Button
                            Padding="16,8"
                            HorizontalAlignment="Right"
                            Command="{Binding ScanCommand}"
                            Content="Rechercher"
                            FontSize="12"
                            Style="{StaticResource CaptivatingButtonStyle}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DiscoveredDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,4"
                                        Padding="15,12"
                                        Background="#1E293B"
                                        BorderBrush="#2563EB"
                                        BorderThickness="0.5"
                                        CornerRadius="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="14"
                                                    FontWeight="Bold"
                                                    Foreground="#F8FAFC"
                                                    Text="{Binding Name}" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="10"
                                                    Foreground="#64748B"
                                                    Text="{Binding Id}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Padding="12,6"
                                                Command="{Binding DataContext.ConnectAndSendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="Transmettre →"
                                                FontSize="11"
                                                Style="{StaticResource CaptivatingButtonStyle}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    Padding="15"
                    Background="#064E3B"
                    BorderBrush="#10B981"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding IsTransferRequestVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock
                            FontSize="13"
                            FontWeight="Black"
                            Foreground="#10B981"
                            Text="📥 Demande reçue" />
                        <TextBlock
                            Margin="0,6"
                            FontSize="12"
                            Foreground="#E2E8F0"
                            Text="{Binding TransferRequestSummary}"
                            TextWrapping="Wrap" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Margin="0,0,5,0"
                                Padding="10,6"
                                Background="#10B981"
                                Command="{Binding AcceptTransferCommand}"
                                Content="Accepter"
                                Cursor="Hand"
                                FontWeight="Bold"
                                Foreground="White" />
                            <Button
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                Padding="10,6"
                                Background="#EF4444"
                                Command="{Binding RejectTransferCommand}"
                                Content="Refuser"
                                Cursor="Hand"
                                FontWeight="Bold"
                                Foreground="White" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border
                    Grid.Row="1"
                    Padding="15"
                    Background="#111827"
                    BorderBrush="#1E293B"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,10"
                            FontWeight="Bold"
                            Foreground="#94A3B8"
                            Text="Flux récents" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RecentTransfers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,3"
                                            Padding="10"
                                            Background="#0F172A"
                                            CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="White"
                                                        Text="{Binding Name}" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="11"
                                                        Foreground="#38BDF8"
                                                        Text="{Binding Type}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="#22C55E"
                                                    Text="{Binding Status}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--  COMPOSANT BAS DE PAGE : PROGRESSION CYBER-FLUIDE  -->
        <Border
            Grid.Row="3"
            Padding="20,15"
            Background="#111827"
            BorderBrush="#1E293B"
            BorderThickness="1"
            CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#F8FAFC"
                        Text="{Binding MessageText}" />
                    <TextBlock
                        Margin="0,4,0,8"
                        FontSize="12"
                        Foreground="#64748B"
                        Text="{Binding ProgressText}" />
                    <Grid>
                        <ProgressBar
                            Height="8"
                            Background="#1E293B"
                            BorderThickness="0"
                            Foreground="#38BDF8"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding TransferProgress}">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid x:Name="TemplateRoot" SnapsToDevicePixels="true">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                                        <Border
                                            x:Name="PART_Indicator"
                                            HorizontalAlignment="Left"
                                            Background="{TemplateBinding Foreground}"
                                            CornerRadius="4" />
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                    </Grid>
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Margin="20,0,0,0"
                    Padding="15,10"
                    VerticalAlignment="Center"
                    Background="#DC2626"
                    Command="{Binding CancelTransferCommand}"
                    Content="Annuler le transfert"
                    Cursor="Hand"
                    FontWeight="Bold"
                    Foreground="White" />
            </Grid>
        </Border>
    </Grid>
</Window>
