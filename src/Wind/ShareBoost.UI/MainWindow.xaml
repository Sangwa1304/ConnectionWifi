<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ShareBoost.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ShareBoost">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="LayoutRoot"
        AllowDrop="True"
        DragOver="OnDragOver"
        DragLeave="OnDragLeave"
        Drop="OnDrop"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        AutomationProperties.Name="ShareBoost, partage de fichiers par Wi-Fi Direct">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre de titre intÃ©grÃ©e Ã  la surface Mica -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            AutomationProperties.Name="Barre de titre ShareBoost">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Margin="18,0,0,0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8D7;" FontSize="18" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                <TextBlock
                    Text="ShareBoost"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                    AutomationProperties.Name="ShareBoost" />
            </StackPanel>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Padding="20,14,20,20"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            ZoomMode="Disabled">
            <StackPanel Spacing="14">

                <!-- Ã‰tat de la connexion et dossier de rÃ©ception -->
                <Border
                    Padding="14"
                    Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            Width="10"
                            Height="10"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource SystemControlForegroundAccentBrush}"
                            AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding CurrentStateDisplayText}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                AutomationProperties.LiveSetting="Polite"
                                AutomationProperties.Name="Ã‰tat Wi-Fi Direct" />
                            <TextBlock
                                Text="{Binding DownloadFolderDisplay}"
                                FontSize="12"
                                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                TextTrimming="CharacterEllipsis"
                                AutomationProperties.Name="Dossier de rÃ©ception" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            MinWidth="44"
                            MinHeight="40"
                            Margin="8,0,0,0"
                            Padding="10,6"
                            Command="{Binding OpenDownloadFolderCommand}"
                            AutomationProperties.Name="Ouvrir le dossier de rÃ©ception">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" />
                                <TextBlock Text="Ouvrir" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="3"
                            MinWidth="44"
                            MinHeight="40"
                            Padding="12,6"
                            Command="{Binding ChangeFolderCommand}"
                            Content="Choisir le dossier"
                            AutomationProperties.Name="Choisir le dossier de rÃ©ception"
                            AutomationProperties.HelpText="Modifie lâ€™emplacement oÃ¹ les fichiers reÃ§us sont enregistrÃ©s." />
                    </Grid>
                </Border>

                <!-- SÃ©lection des fichiers -->
                <Border
                    Padding="16"
                    Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    Text="Fichiers Ã  envoyer"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                    AutomationProperties.HeadingLevel="Level1" />
                                <TextBlock
                                    Text="{Binding DropStatusText}"
                                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                MinHeight="40"
                                Padding="12,6"
                                Command="{Binding BrowseCommand}"
                                AutomationProperties.Name="Ajouter des fichiers ou dossiers">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" />
                                    <TextBlock Text="Ajouter" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="2"
                                MinWidth="44"
                                MinHeight="40"
                                Margin="8,0,0,0"
                                Padding="10,6"
                                Command="{Binding DeleteAllCommand}"
                                Visibility="{Binding PendingFilesVisibility}"
                                AutomationProperties.Name="Retirer tous les fichiers de la liste">
                                <FontIcon Glyph="&#xE74D;" />
                            </Button>
                        </Grid>

                        <Border
                            Padding="18,16"
                            Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                            CornerRadius="10"
                            Visibility="{Binding EmptyPendingFilesVisibility}">
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <FontIcon
                                    Glyph="&#xE8E5;"
                                    FontSize="26"
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                                    AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock
                                    Text="DÃ©posez vos fichiers ici ou utilisez Ajouter"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                                <TextBlock
                                    Text="Vous pouvez aussi sÃ©lectionner des fichiers depuis votre ordinateur."
                                    FontSize="12"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </Border>

                        <ListView
                            ItemsSource="{Binding PendingFiles}"
                            SelectionMode="None"
                            IsTabStop="False"
                            MaxHeight="280"
                            Visibility="{Binding PendingFilesVisibility}"
                            AutomationProperties.Name="Liste des fichiers prÃªts Ã  lâ€™envoi">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="8" MinHeight="56">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            MinHeight="48"
                                            Padding="8,6"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.OpenFileCommand, ElementName=LayoutRoot}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Ouvrir le fichier sÃ©lectionnÃ©">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    Glyph="{Binding IconGlyph}"
                                                    FontSize="21"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                                                    AutomationProperties.AccessibilityView="Raw" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        FontWeight="SemiBold"
                                                        TextTrimming="CharacterEllipsis"
                                                        Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                                                    <TextBlock
                                                        Text="{Binding Sizee}"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button
                                            Grid.Column="1"
                                            MinWidth="44"
                                            MinHeight="44"
                                            Padding="8"
                                            AutomationProperties.Name="Autres actions pour le fichier sÃ©lectionnÃ©"
                                            AutomationProperties.HelpText="Ouvre les actions de suppression et dâ€™emplacement du fichier.">
                                            <FontIcon Glyph="&#xE712;" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem
                                                        Text="Ouvrir lâ€™emplacement"
                                                        Command="{Binding DataContext.OpenSourceDirectoryCommand, ElementName=LayoutRoot}"
                                                        CommandParameter="{Binding}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8B7;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem
                                                        Text="Retirer de la liste"
                                                        Command="{Binding DataContext.DeleteItemCommand, ElementName=LayoutRoot}"
                                                        CommandParameter="{Binding}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74D;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Appareils disponibles -->
                <Border
                    Padding="16"
                    Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding ConnectedVisibilityOff}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    Text="Appareils Ã  proximitÃ©"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                    AutomationProperties.HeadingLevel="Level1" />
                                <TextBlock
                                    Text="Choisissez un appareil pour vous connecter."
                                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                MinHeight="40"
                                Padding="12,6"
                                Command="{Binding ScanCommand}"
                                Visibility="{Binding StartSubscribeButtonVisibily}"
                                AutomationProperties.Name="Rechercher les appareils Ã  proximitÃ©">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" />
                                    <TextBlock Text="Rechercher" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="2"
                                MinWidth="44"
                                MinHeight="40"
                                Margin="8,0,0,0"
                                Padding="10,6"
                                Command="{Binding RetryCommand}"
                                Visibility="{Binding StopSubscribeButtonVisibily}"
                                AutomationProperties.Name="Relancer la recherche dâ€™appareils">
                                <FontIcon Glyph="&#xE72C;" />
                            </Button>
                        </Grid>

                        <Border Padding="12" Visibility="{Binding InformationWifiVisibily}">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock
                                Text="Aucun appareil dÃ©tectÃ© pour le moment"
                                FontWeight="SemiBold"
                                TextAlignment="Center"
                                Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                Visibility="{Binding PageReloadNoVisible}" />
                            <TextBlock
                                Text="VÃ©rifiez que lâ€™autre appareil est allumÃ© et visible, puis relancez la recherche."
                                TextWrapping="Wrap"
                                MaxWidth="420"
                                TextAlignment="Center"
                                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                Visibility="{Binding PageReloadNoVisible}" />
                            <TextBlock
                                Text="Wi-Fi Direct nâ€™est pas disponible sur cet appareil. VÃ©rifiez lâ€™adaptateur et son Ã©tat."
                                TextWrapping="Wrap"
                                MaxWidth="420"
                                TextAlignment="Center"
                                Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                Visibility="{Binding PageReloadVisible}" />
                        </StackPanel>
                        </Border>

                        <ListView
                            ItemsSource="{Binding DiscoveredDevices}"
                            SelectionMode="None"
                            IsTabStop="False"
                            MaxHeight="300"
                            AutomationProperties.Name="Appareils Wi-Fi Direct disponibles">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="8" MinHeight="64">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Glyph="&#xE701;"
                                            FontSize="20"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                                            AutomationProperties.AccessibilityView="Raw" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding Name}"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                                            <TextBlock
                                                Text="{Binding Id}"
                                                FontSize="11"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            MinHeight="40"
                                            Padding="10,6"
                                            Command="{Binding DataContext.ConnectCommand, ElementName=LayoutRoot}"
                                            CommandParameter="{Binding}"
                                            Content="Connecter"
                                            AutomationProperties.Name="Connecter Ã  lâ€™appareil sÃ©lectionnÃ©" />
                                        <Button
                                            Grid.Column="3"
                                            MinHeight="40"
                                            Margin="6,0,0,0"
                                            Padding="10,6"
                                            Command="{Binding DataContext.ConnectAndSendCommand, ElementName=LayoutRoot}"
                                            CommandParameter="{Binding}"
                                            Content="Connecter et envoyer"
                                            AutomationProperties.Name="Se connecter Ã  cet appareil puis envoyer les fichiers sÃ©lectionnÃ©s"
                                            AutomationProperties.HelpText="Disponible lorsquâ€™au moins un fichier est prÃªt Ã  lâ€™envoi." />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Appareil connectÃ© -->
                <Border
                    Padding="16"
                    Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding ConnectedVisibilityOn}">
                    <StackPanel Spacing="10">
                        <TextBlock
                            Text="Appareil connectÃ©"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                            AutomationProperties.HeadingLevel="Level1" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding PeerConnecte.Name}"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                                <TextBlock
                                    Text="{Binding SelectedPeerName}"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                MinHeight="40"
                                Padding="12,6"
                                Command="{Binding SendCommand}"
                                CommandParameter="{Binding PeerConnecte}"
                                Content="Envoyer"
                                AutomationProperties.Name="Envoyer les fichiers Ã  lâ€™appareil connectÃ©" />
                            <Button
                                Grid.Column="2"
                                MinHeight="40"
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Command="{Binding DisconnectCommand}"
                                CommandParameter="{Binding PeerConnecte}"
                                Content="DÃ©connecter"
                                AutomationProperties.Name="DÃ©connecter lâ€™appareil actuel" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Demande de rÃ©ception -->
                <Border
                    Padding="16"
                    Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{ThemeResource SystemControlForegroundAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding IncomingRequestVisibility}">
                    <StackPanel Spacing="10">
                        <TextBlock
                            Text="Demande de rÃ©ception"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                            AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock
                            Text="{Binding TransferRequestSummary}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                            AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                MinWidth="110"
                                MinHeight="42"
                                Command="{Binding AcceptTransferCommand}"
                                Content="Accepter"
                                AutomationProperties.Name="Accepter le transfert entrant" />
                            <Button
                                MinWidth="110"
                                MinHeight="42"
                                Command="{Binding RejectTransferCommand}"
                                Content="Refuser"
                                AutomationProperties.Name="Refuser le transfert entrant" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ActivitÃ© et progression -->
                <Border
                    Padding="16"
                    Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="ActivitÃ©"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                            AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock
                            Text="{Binding MessageText}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                            AutomationProperties.LiveSetting="Polite"
                            AutomationProperties.Name="Ã‰tat de lâ€™opÃ©ration" />
                        <TextBlock
                            Text="{Binding ProgressText}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock
                            Text="{Binding FileClient}"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            AutomationProperties.Name="Fichier reÃ§u" />
                        <ProgressBar
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding CounterClient}"
                            AutomationProperties.Name="Progression de la rÃ©ception" />
                        <TextBlock
                            Text="{Binding FileServer}"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            AutomationProperties.Name="Fichier envoyÃ©" />
                        <ProgressBar
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding CounterServer}"
                            AutomationProperties.Name="Progression de lâ€™envoi" />
                        <Button
                            HorizontalAlignment="Right"
                            MinHeight="40"
                            Padding="12,6"
                            Command="{Binding CancelTransferCommand}"
                            Content="Annuler"
                            AutomationProperties.Name="Annuler le transfert ou la demande en cours" />
                    </StackPanel>
                </Border>

                <!-- Historique des transferts -->
                <Border
                    Padding="16"
                    Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock
                                Text="Transferts rÃ©cents"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                AutomationProperties.HeadingLevel="Level1" />
                            <Button
                                HorizontalAlignment="Right"
                                MinHeight="40"
                                Padding="10,6"
                                Command="{Binding ClearTransferHistoryCommand}"
                                Content="Effacer lâ€™historique"
                                AutomationProperties.Name="Effacer lâ€™historique des transferts"
                                Visibility="{Binding RecentTransfersVisibility}" />
                        </Grid>
                        <TextBlock
                            Text="Les transferts terminÃ©s apparaÃ®tront ici."
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Visibility="{Binding EmptyRecentTransfersVisibility}" />
                        <ListView
                            ItemsSource="{Binding RecentTransfers}"
                            SelectionMode="None"
                            IsTabStop="False"
                            MaxHeight="250"
                            AutomationProperties.Name="Historique des transferts">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12" MinHeight="48">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding Name}"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                                            <TextBlock
                                                Text="{Binding Type}"
                                                FontSize="12"
                                                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Status}"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                            AutomationProperties.Name="RÃ©sultat du transfert" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Margin="16"
            Padding="24"
            Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{ThemeResource SystemControlForegroundAccentBrush}"
            BorderThickness="3"
            CornerRadius="14"
            IsHitTestVisible="False"
            Visibility="{Binding DropOverlayVisibility}"
            AutomationProperties.Name="Zone de dÃ©pÃ´t de fichiers">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <FontIcon
                    Glyph="&#xE74A;"
                    FontSize="32"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                    AutomationProperties.AccessibilityView="Raw" />
                <TextBlock
                    Text="DÃ©posez les fichiers pour les ajouter Ã  la liste"
                    FontSize="18"
                    FontWeight="SemiBold"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                    AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
