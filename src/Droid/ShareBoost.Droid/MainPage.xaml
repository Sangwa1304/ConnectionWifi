<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ShareBoost.Droid.Models"
             x:Class="ShareBoost.Droid.MainPage"
             Title="ShareBoost"
             BackgroundColor="{AppThemeBinding Light=#F5F7FB, Dark=#10141C}">
    <ContentPage.Resources>
        <Style TargetType="Border" x:Key="Panel">
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#E2E8F0, Dark=#293344}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#171E2A}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="18" /></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid Padding="20,18,20,12" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="SHAREBOOST" FontSize="12" CharacterSpacing="2" FontAttributes="Bold" TextColor="#64748B" />
                <Label Text="Partage à proximité" FontSize="25" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=White}" />
            </VerticalStackLayout>
            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#2563EB" VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,6,18,28" Spacing="14">
                <Border Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Réseau Wi-Fi Direct" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=White}" />
                            <Label Grid.Column="1" Text="{Binding Status}" FontSize="12" TextColor="#2563EB" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding Message}" FontSize="13" TextColor="{AppThemeBinding Light=#475569, Dark=#B8C4D6}" />
                        <Label Text="{Binding Error}" IsVisible="{Binding HasError}" TextColor="#DC2626" FontSize="13" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Initialiser" Command="{Binding InitializeCommand}" />
                            <Button Grid.Column="1" Text="Rechercher" Command="{Binding DiscoverCommand}" BackgroundColor="#2563EB" TextColor="White" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Publier ce téléphone" Command="{Binding PublishCommand}" BackgroundColor="{AppThemeBinding Light=#E8F0FF, Dark=#1D3153}" TextColor="#2563EB" />
                            <Button Grid.Column="1" Text="Paramètres Wi-Fi" Command="{Binding OpenWifiSettingsCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Appareils détectés" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=White}" />
                        <CollectionView ItemsSource="{Binding Peers}" SelectionMode="None" EmptyView="Aucun appareil détecté. Lancez une recherche.">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="42,*,Auto" Padding="0,9" ColumnSpacing="10">
                                        <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" BackgroundColor="#E8F0FF" StrokeShape="RoundRectangle 12">
                                            <Label Text="⌁" FontSize="24" TextColor="#2563EB" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=White}" />
                                            <Label Text="{Binding Id}" FontSize="11" TextColor="#64748B" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2" Text="Connecter" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ConnectCommand}" CommandParameter="{Binding}" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Fichiers à partager" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=White}" />
                        <Label Text="Le sélecteur système Android permet de parcourir les emplacements autorisés. Les fichiers sélectionnés sont copiés dans le cache privé pour garantir leur disponibilité pendant la session." FontSize="12" TextColor="#64748B" />
                        <Button Text="＋ Ajouter des fichiers" Command="{Binding PickFilesCommand}" BackgroundColor="#2563EB" TextColor="White" />
                        <Label Text="{Binding SelectedFilesSummary}" FontSize="12" FontAttributes="Bold" TextColor="#64748B" />
                        <CollectionView ItemsSource="{Binding SelectedFiles}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:TransferFileItem">
                                    <Grid ColumnDefinitions="54,*,Auto" Padding="0,7" ColumnSpacing="10">
                                        <Border WidthRequest="50" HeightRequest="50" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#EEF2F7, Dark=#263244}" StrokeShape="RoundRectangle 10">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Aspect="AspectFill" />
                                                <Label Text="{Binding Kind}" FontSize="9" TextColor="#64748B" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation" TextColor="{AppThemeBinding Light=#0F172A, Dark=White}" />
                                            <Label Text="{Binding SizeLabel}" FontSize="11" TextColor="#64748B" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2" Text="Retirer" FontSize="11" Padding="9,6" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveFileCommand}" CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Button Text="Effacer la sélection" Command="{Binding ClearFilesCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Fichiers reçus" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=White}" />
                        <CollectionView ItemsSource="{Binding ReceivedFiles}" SelectionMode="None" EmptyView="Aucun fichier reçu pour le moment.">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:TransferFileItem">
                                    <Grid ColumnDefinitions="54,*,Auto,Auto" Padding="0,7" ColumnSpacing="8">
                                        <Border WidthRequest="50" HeightRequest="50" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#EEF2F7, Dark=#263244}" StrokeShape="RoundRectangle 10">
                                            <Image Source="{Binding Thumbnail}" Aspect="AspectFill" />
                                            <Label Text="{Binding Kind}" FontSize="9" TextColor="#64748B" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation" TextColor="{AppThemeBinding Light=#0F172A, Dark=White}" />
                                            <Label Text="{Binding SizeLabel}" FontSize="11" TextColor="#64748B" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2" Text="Ouvrir" FontSize="11" Padding="8,6" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenReceivedFileCommand}" CommandParameter="{Binding}" />
                                        <Button Grid.Column="3" Text="Partager" FontSize="11" Padding="8,6" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ShareReceivedFileCommand}" CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Session et transfert" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=White}" />
                        <Label Text="{Binding ConnectionRole}" FontSize="13" TextColor="#2563EB" />
                        <Label Text="{Binding RemoteAddress}" FontSize="12" TextColor="#64748B" />
                        <ProgressBar Progress="{Binding TransferProgress}" ProgressColor="#2563EB" />
                        <Label Text="{Binding TransferStatus}" FontSize="12" TextColor="#64748B" />
                        <Label Text="Les deux canaux TCP réutilisent le protocole existant de Windows. Toute réception entrante doit être acceptée explicitement." FontSize="12" TextColor="#64748B" />
                        <Button Text="Envoyer les fichiers" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}" BackgroundColor="#2563EB" TextColor="White" />
                        <Button Text="Annuler le transfert" Command="{Binding CancelTransferCommand}" />
                        <Button Text="Déconnecter" Command="{Binding DisconnectCommand}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
