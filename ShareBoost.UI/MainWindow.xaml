<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ShareBoost.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ShareBoost.UI"
    xmlns:viewmodels="using:ShareBoost.UI.ViewModels"
    mc:Ignorable="d"
    Title="ShareBoost">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid 
        x:Name="LayoutRoot"
        AllowDrop="True"
        DragOver="OnDragOver"
        DragLeave="OnDragLeave"
        Drop="OnDrop"
        AutomationProperties.Name="Windows Wi-Fi P2P">
        <Grid.Resources>

            <local:ModernThumbnailConverter x:Key="ModernIconConverter"/>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <!-- Style de Bouton WinUI Moderne -->
            <Style x:Key="CaptivatingButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#2563EB" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <!-- Style Cyber-Réactif de la Zone Drag & Drop Piloté par le ViewModel -->
            <Style x:Key="DropZoneButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#1E293B" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="dropContainer">
                                <Rectangle
                                    x:Name="dropBorder"
                                    Fill="{StaticResource AccentAAFillColorDisabled}"
                                    RadiusX="12"
                                    RadiusY="12"
                                    Stroke="#334155"
                                    StrokeDashArray="4 4"
                                    StrokeThickness="2" />
                                <Border Padding="30">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid
            Background="{StaticResource AccentAAFillColorDisabled}"
            Opacity="0.6"
            Padding="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- EN-TÊTE : STATUT GLOBAL -->
            <Border
                Grid.Row="0"
                Padding="5"
                Background="#050b1a8c"
                BorderBrush="#8f8e8a8f"
                BorderThickness="0"
                CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center">
                        <Ellipse
                             Width="10"
                             Height="10"
                             Margin="0,0,10,0"
                             Fill="{Binding CurrentStateDisplayColor}"/>
                        <TextBlock 
                            FontSize="11" 
                            FontWeight="Black" 
                            Foreground="#64748B" 
                            VerticalAlignment="Center" 
                            Text="Etat |" />
                        <TextBlock 
                            HorizontalAlignment="Left"
                            FontSize="12" 
                            Foreground="#64748B" 
                            Margin="1,0"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text=" Dossier :  " />
                    </StackPanel>
                    <StackPanel
                        VerticalAlignment="Center"
                        Grid.Column="1">
                        <Button
                            Padding="0"
                            Command="{Binding OpenDownloadFolderCommand}"
                            Margin="2,0,0,0"
                            BorderBrush="Transparent"
                            Background="Transparent"
                            AutomationProperties.Name="ouvrir le dossier de réception">
                            <TextBlock
                                FontSize="12"
                                FontWeight="Bold" 
                                Foreground="#b4c0cd" 
                                Text="{Binding DownloadFolderDisplay}" 
                                TextTrimming="CharacterEllipsis"/>
                        </Button>

                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Padding="10,4"
                        Margin="2,0,0,0"
                        Background="{StaticResource AccentAAFillColorDisabled}"
                        Command="{Binding ChangeFolderCommand}"
                        Content="Changer"
                        AutomationProperties.Name="Changer le dossier de réception"
                        FontSize="11" />
                </Grid>
            </Border>

            <!-- ZONE GLISSER-DÉPOSER / FICHIERS -->
            <Grid 
                Grid.Row="1">
                <!-- Bouton Drop par défaut -->
                <Button
                    Style="{StaticResource DropZoneButtonStyle}"
                    Command="{Binding BrowseCommand}"
                    AutomationProperties.Name="Ajouter des fichiers ou dossiers à envoyer"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#1E293B"
                    Visibility="{Binding NoPendingFiles, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <StackPanel
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                        <TextBlock 
                            Margin="0,0,0,10" 
                            HorizontalAlignment="Center"
                            FontSize="36" 
                            Foreground="gray"
                            Text="⚡" />
                        <TextBlock
                            HorizontalAlignment="Center" 
                            FontSize="16" 
                            FontWeight="Bold" 
                            Foreground="#F1F5F9" 
                            Text="Glissez-déposez vos fichiers ici" />
                        <TextBlock
                            Margin="0,4,0,0" 
                            HorizontalAlignment="Center" 
                            FontSize="12" 
                            Foreground="#64748B" 
                            Text="ou cliquez pour parcourir" />
                    </StackPanel>
                </Button>

                <!-- Liste des fichiers prêts -->
                <Border
                    Padding="2,15"
                    Height="Auto"
                    Background="{StaticResource AccentAAFillColorDisabled}"
                    BorderBrush="#8f8e8a8f"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding HasPendingFiles, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <Border.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </Border.Transitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid 
                            Grid.Row="0" 
                            Margin="0,0,0,10">
                            <TextBlock 
                                VerticalAlignment="Center" 
                                FontWeight="Bold" 
                                Foreground="#94A3B8" 
                                Text="Fichiers prêts à l'envoi" />
                            <TextBlock
                                Margin="0,22,0,0"
                                Foreground="#64748B"
                                Text="{Binding DropStatusText}" />
                            <StackPanel
                                Visibility="Collapsed"
                                Padding="1"
                                BorderThickness="1"
                                HorizontalAlignment="Center" 
                                Orientation="Horizontal">

                                <Button Margin="2,0">
                                    <FontIcon Glyph="&#xE768;" />
                                </Button>
                                <Button Margin="2,0">
                                    <FontIcon Glyph="&#xE769;" />
                                </Button>
                            </StackPanel>
                            <StackPanel 
                                HorizontalAlignment="Right" 
                                Orientation="Horizontal">
                                <Button
                                    FontFamily="Segoe Fluent Icons"
                                    Padding="5"
                                    Margin="8,0"
                                    Background="#e925e3b3"
                                    Command="{Binding BrowseCommand}" 
                                    Foreground="White"
                                    AutomationProperties.Name="Ajouter des éléments" >
                                    <FontIcon Glyph="&#xE723;&#xE710;" />
                                </Button>
                                <Button 
                                    FontFamily="Segoe Fluent Icons"
                                    Padding="5" 
                                    FontWeight="Bold"
                                    Background="#e92525dd" 
                                    Command="{Binding DeleteAllCommand}"
                                    Foreground="red"
                                    AutomationProperties.Name="Supprimer tous les éléments" >
                                    <FontIcon Glyph="&#xE74D;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ScrollViewer
                            Grid.Row="1"
                            Background="{Binding}"
                            BorderBrush="Transparent"
                            BorderThickness="0.5"
                            CornerRadius="8">
                            <ItemsControl ItemsSource="{Binding PendingFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Image Source="{Binding PathFile ,Converter={StaticResource ModernIconConverter}}"/>
                                            <Button
                                            Margin="1,4,9,4"
                                            Background="{StaticResource AccentAAFillColorDisabled}"
                                            HorizontalContentAlignment="Stretch"
                                            BorderBrush="#8f8e8a8f"
                                                HorizontalAlignment="Stretch"
                                            BorderThickness="0.45"
                                            AutomationProperties.Name="Se connecter et envoyer à cet appareil"
                                            Command="{Binding DataContext.ConnectAndSendCommand, ElementName=LayoutRoot}"
                                            CommandParameter="{Binding}"
                                            Padding="8"
                                            CornerRadius="8">
                                            <Border
                                                 AutomationProperties.Name="Se connecter à cet appareil"
                                                BorderBrush="Transparent"
                                                Background="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel
                                                       VerticalAlignment="Center"
                                                        HorizontalAlignment="Stretch"
                                                        Orientation="Horizontal">

                                                        <StackPanel 
                                                    Spacing="20"
                                                          Orientation="Horizontal">
                                                        <FontIcon Glyph="&#xE701;" />
                                                            <TextBlock 
                                                                FontSize="16"
                                                                FontWeight="Bold" 
                                                                Foreground="#F8FAFC" 
                                                                Text="{Binding Name}" />
                                                        </StackPanel>

                                                    </StackPanel>
                                                    <FontIcon 
                                                        Grid.Column="1"
                                                        Glyph="&#xE76C;" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                        <Border 
                                            Margin="2,1,6,1"
                                            Padding="8"
                                            CornerRadius="1"
                                                Background="{StaticResource AccentAAFillColorDisabled}" 
                                                BorderThickness="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button 
                                                    FontSize="20"
                                                    Foreground="#9e9ebe"
                                                    FontWeight="SemiLight"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,4,0"
                                                    Command="{Binding DataContext.OpenSourceDirectoryCommand, ElementName=LayoutRoot}" 
                                                    CommandParameter="{Binding}"
                                                    FontFamily="Segoe Fluent Icons"
                                                    Padding="0"
                                                    BorderBrush="Transparent"
                                                    Background="Transparent"
                                                    Content="&#xE8DA;"/>
                                            <Button
                                                    FontSize="20"
                                                    Grid.Column="1"       
                                                    Foreground="#9e9ebe"
                                                    FontWeight="SemiLight"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,4,0"
                                                    BorderBrush="Transparent"
                                                    Background="Transparent"
                                                    Command="{Binding DataContext.OpenFileCommand, ElementName=LayoutRoot}" 
                                                    CommandParameter="{Binding}"
                                                    FontFamily="Segoe Fluent Icons"
                                                    Padding="0"
                                                    Content="&#xE8E5;"/>
                                            <Grid Grid.Column="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                <StackPanel
                                                    CanBeScrollAnchor="True"
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                    Orientation="Horizontal">

                                                    <!--Button
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        HorizontalAlignment="Right"
                                                        Padding="0"
                                                        Command="{Binding DataContext.PlayThisCommand, ElementName=LayoutRoot}" 
                                                        CommandParameter="{Binding}">
                                                        <FontIcon Glyph="&#xE768;" />
                                                    </Button-->
                                                    <StackPanel 
                                                            VerticalAlignment="Center">
                                                        <TextBlock 
                                                                Foreground="#e0e6eb"
                                                                FontSize="12" 
                                                                FontWeight="Light" 
                                                                Text="{Binding Name}" />
                                                        <TextBlock 
                                                                Margin="0,2,0,0" 
                                                                FontSize="9" 
                                                                Foreground="#94A3B9"
                                                                Text="{Binding Sizee}" />
                                                    </StackPanel>

                                                </StackPanel>
                                                <Button 
                                                            FontFamily="Segoe Fluent Icons"
                                                            Grid.Column="1" 
                                                            Background="Transparent" 
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            HorizontalAlignment="Right"
                                                            Margin="12,0"
                                                            AutomationProperties.Name="Supprimer ce fichier" 
                                                            Command="{Binding DataContext.DeleteItemCommand, ElementName=LayoutRoot}" 
                                                            CommandParameter="{Binding}" 
                                                            Content="&#xE74D;" 
                                                            Foreground="Red" />
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ZONE APPAREILS DISPONIBLES ET HISTORIQUE -->
            <Grid Grid.Row="2" Margin="0,5,0,15" x:Name="RootGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Appareil connecté -->
                <Border 
                    Background="#111827" 
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    Padding="15"
                    BorderBrush="#1E293B"
                    BorderThickness="4"
                    Visibility="{Binding ConnectedVisibilityOn}"
                    CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="18" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" Text="Appareil connecté :" Margin="0,8"/>
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,5,0">
                            <TextBlock FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Text="{Binding PeerConnecte.Name}" />
                            <TextBlock Margin="0,2,0,0" FontSize="9" HorizontalAlignment="Center" Foreground="#64748B" Text="{Binding PeerConnecte.Id}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,12" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Padding="6,6" Margin="2" Command="{Binding DisconnectCommand}" CommandParameter="{Binding PeerConnecte}" Content="Déconnecter" Background="Red"/>
                            <Button Padding="6,6" Margin="2" Command="{Binding SendCommand}" CommandParameter="{Binding PeerConnecte}" Content="Envoyer ->" Background="Green" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Liste des appareils à proximité -->
                <Border 
                    Background="{StaticResource AccentAAFillColorDisabled}" 
                    Grid.Column="0"
                    Margin="2,0"
                    Padding="15"
                    BorderBrush="#8f8e8a8f" 
                    BorderThickness="1" 
                    Visibility="{Binding ConnectedVisibilityOff}" 
                    CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Vertical">
                                <TextBlock
                                    FontSize="14" 
                                    FontWeight="Black" 
                                    Foreground="#9e9ebe" 
                                    Text="Appareils à proximité" />
                                <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="#64748B" Text="Sélectionnez une cible" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Command="{Binding ScanCommand}" Content="Rechercher" AutomationProperties.Name="Rechercher des appareils" Visibility="{Binding StartSubscribeButtonVisibily}" />
                            <Button
                                HorizontalAlignment="Right"
                                Background="{StaticResource AccentAAFillColorDisabled}"
                                Foreground="{StaticResource AccentAAFillColorDisabled}"
                                FontFamily="Segoe Fluent Icons"
                                Command="{Binding RetryCommand}" 
                                Content="&#xE72C;" 
                                AutomationProperties.Name="Relancer la recherche d’appareils"
                                Visibility="{Binding StopSubscribeButtonVisibily}" />
                        </Grid>
                        <StackPanel
                            Grid.Row="1"
                            Margin="0,0,0,40"
                            Visibility="{Binding InformationWifiVisibily}" 
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                            <TextBlock
                                FontWeight="Black" 
                                FontFamily="Corbel"
                                
                                Padding="1"
                                Foreground="#9e9ebe"
                                FontSize="20"
                                Text="Aucun Appareil disponible pour l'instant"/>
                            <TextBlock
                                FontWeight="Black" 
                                FontFamily="Corbel"
                                Foreground="#9e9ebe" 
                                TextTrimming="CharacterEllipsis"
                                FontSize="18"
                               HorizontalAlignment="Center"
                                Padding="1"
                                Text="Assurez-vous que l'autre Appareil est visible"/>
                        </StackPanel>
                        <ScrollViewer 
                            Padding="2"
                            CornerRadius="9"
                            VerticalScrollBarVisibility ="Auto"
                            Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding DiscoveredDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Margin="1,4,9,4"
                                            Background="{StaticResource AccentAAFillColorDisabled}"
                                            HorizontalContentAlignment="Stretch"
                                            BorderBrush="#8f8e8a8f"
                                                HorizontalAlignment="Stretch"
                                            BorderThickness="0.45"
                                            AutomationProperties.Name="Se connecter et envoyer à cet appareil"
                                            Command="{Binding DataContext.ConnectAndSendCommand, ElementName=LayoutRoot}"
                                            CommandParameter="{Binding}"
                                            Padding="8"
                                            CornerRadius="8">
                                            <Border
                                                 AutomationProperties.Name="Se connecter à cet appareil"
                                                BorderBrush="Transparent"
                                                Background="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel
                                                   VerticalAlignment="Center"
                                                    HorizontalAlignment="Stretch"
                                                    Orientation="Horizontal">
                                                       
                                                        <StackPanel 
                                                            Spacing="20"
                                                                  Orientation="Horizontal">
                                                            <FontIcon Glyph="&#xE701;" />
                                                            <TextBlock 
                                                            FontSize="16"
                                                            FontWeight="Bold" 
                                                            Foreground="#F8FAFC" 
                                                            Text="{Binding Name}" />
                                                        </StackPanel>

                                                    </StackPanel>
                                                    <FontIcon 
                                                        Grid.Column="1"
                                                        Glyph="&#xE76C;" />

                                                    <!--Button
                                                        Grid.Column="1"
                                                        FontSize="20"
                                                        Foreground="#9e9ebe"
                                                        Background="Transparent" 
                                                        FontFamily="Segoe Fluent Icons"
                                                        Command="{Binding DataContext.ConnectAndSendCommand, ElementName=LayoutRoot}"
                                                        CommandParameter="{Binding}"
                                                        Content="&#xE724;"
                                                        AutomationProperties.Name="Se connecter et envoyer à cet appareil"/-->
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Volet de droite : Demande & Historique -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Demande de transfert entrante -->
                    <Border 
                        Grid.Row="0"
                        Margin="0,0,0,10" 
                        Padding="15"
                        Width="250"
                        Background="#064E3B" 
                        BorderBrush="#10B981" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Visibility="{Binding IsTransferRequestVisible, Converter={StaticResource BoolToVisibility}}">
                        <Border.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True" />
                            </TransitionCollection>
                        </Border.Transitions>
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="Black" Foreground="#10B981" Text="📥 Demande reçue" />
                            <TextBlock Margin="0,6" FontSize="12" Foreground="#E2E8F0" Text="{Binding TransferRequestSummary}" TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Margin="0,0,5,0" Background="#10B981" Command="{Binding AcceptTransferCommand}" Content="Accepter" AutomationProperties.Name="Accepter le transfert entrant" Foreground="White" />
                                <Button Grid.Column="1" Margin="5,0,0,0" Background="#EF4444" Command="{Binding RejectTransferCommand}" Content="Refuser" AutomationProperties.Name="Refuser le transfert entrant" Foreground="White" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Historique -->
                    <Border
                        Grid.Row="1" 
                        Padding="15" 
                        Width="250"
                        Visibility="{Binding ConnectedVisibilityOn}" 
                        Background="#111827" 
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock VerticalAlignment="Center" FontWeight="Bold" Foreground="#94A3B8" Text="Flux récents" />
                                <Button HorizontalAlignment="Right" Background="Transparent" Command="{Binding ClearTransferHistoryCommand}" Content="Effacer" AutomationProperties.Name="Effacer l’historique des transferts" Foreground="#64748B" />
                            </Grid>
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding RecentTransfers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,3" Padding="10" Background="#0F172A" CornerRadius="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="White" Text="{Binding Name}" />
                                                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#38BDF8" Text="{Binding Type}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Text="{Binding Status}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- PROGRESSION DE BAS DE PAGE -->
            <Border 
                Grid.Row="3"
                Padding="20,15" 
                    Visibility="{Binding ConnectedVisibilityOn}" 
                Background="#050b1a8c" 
                BorderBrush="#8f8e8a8f" 
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="11" Foreground="#94A3B8" Text="Pair :" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" Text="{Binding SelectedPeerName}" />
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Text="{Binding MessageText}" />
                        <TextBlock Margin="0,4,0,8" FontSize="12" Foreground="#64748B" Text="{Binding ProgressText}" />
                        <TextBlock FontSize="11" Foreground="#94A3B8" Text="{Binding FileClient}" />
                        <ProgressBar Height="8" Maximum="100" Minimum="0" Value="{Binding TransferProgress}" />
                    </StackPanel>
                    <Button Grid.Column="1" Margin="20,0,0,0" Background="#2c0712" Command="{Binding CancelTransferCommand}" Content="Annuler" AutomationProperties.Name="Annuler le transfert en cours" Foreground="White" />
                </Grid>
            </Border>
        </Grid>
        <!-- Page Reload Overlay -->
        <Border 
            Background="Black"
            Opacity="0.9"
            Visibility="{Binding PageReloadVisible}">

            <Button 
                    Padding="0"
                    AutomationProperties.Name="Recharger la page" 
                    Command="{Binding ReloadCommand}" 
                    VerticalAlignment="Center" 
                    Background="Transparent"
                    BorderBrush="Transparent"
                    HorizontalAlignment="Center" >
                <StackPanel>

                    <TextBlock
                        FontWeight="Black" 
                        FontFamily="Corbel"
                        Padding="1"
                        Foreground="#9e9ebe"  
                        FontSize="20"
                        Text="Assurez-vous de garder votre wifi allumé"/>
                    <TextBlock
                        FontWeight="Black" 
                        FontFamily="Corbel"
                        Foreground="#9e9ebe" 
                        TextTrimming="CharacterEllipsis"
                        FontSize="24"
                        HorizontalAlignment="Center"
                        Padding="1"
                        Text="Appuyer ici pour recharger"/>

                </StackPanel>
            </Button>
        </Border>
        
    </Grid>
</Window>
